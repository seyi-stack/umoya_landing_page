					"control": "textarea",
					"label": "Content (HTML)",
					"esc": "raw",
					"default": "\n              Once your departure is confirmed, it is guaranteed. From that point you can book flights and make arrangements knowing your journey will proceed as planned.\n            "
				},
				{
					"id": "_uew_sep",
					"control": "hidden",
