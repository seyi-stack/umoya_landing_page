			],
			"rows": [
				{
					"role": "listitem",
					"aria_hidden": "true",
					"viewbox": "0 0 24 24",
					"svg_markup": "\n                  <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/>\n                  <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"/>\n                  <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"/>\n                  <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/>\n                ",
					"title": "Plan with absolute confidence",
					"sub": "Guaranteed departures",
					"aria_hidden_2": "true",
					"viewbox_2": "0 0 24 24",
					"icon_points": "6 9 12 15 18 9",
					"role_2": "region",
					"content_markup": "\n              Once your departure is confirmed, it is guaranteed. From that point you can book flights and make arrangements knowing your journey will proceed as planned.\n            ",
					"_uew_sep": ""
				},
				{
					"role": "listitem",
					"aria_hidden": "true",
					"viewbox": "0 0 24 24",
					"svg_markup": "\n                  <path d=\"M12 20h9\"/>\n                  <path d=\"M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"/>\n                ",
					"title": "Your journey, your way",
					"sub": "Thoughtful personalization",
					"aria_hidden_2": "true",
					"viewbox_2": "0 0 24 24",
					"icon_points": "6 9 12 15 18 9",
					"role_2": "region",
					"content_markup": "\n              Each itinerary is carefully designed, and yours can flex to your interests. Optional experiences let you add private tastings, extended time at a site, or access to a particular host.\n            ",
					"_uew_sep": "\n\n        <!-- ── Item 3: Personalization ────────────────── -->\n        "
				},
				{
					"role": "listitem",
					"aria_hidden": "true",
					"viewbox": "0 0 24 24",
					"svg_markup": "\n                  <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                ",
					"title": "Peace of mind for your investment",
					"sub": "Travel protection",
					"aria_hidden_2": "true",
					"viewbox_2": "0 0 24 24",
					"icon_points": "6 9 12 15 18 9",
					"role_2": "region",
					"content_markup": "\n              We <strong>strongly recommend travel insurance</strong> at the time of booking. Your travel expert can guide you to reputable providers so you can focus on the journey, not the logistics.\n            ",
					"_uew_sep": "\n\n        <!-- ── Item 4: Travel Protection ─────────────── -->\n        "
				},
				{
					"role": "listitem",
					"aria_hidden": "true",
					"viewbox": "0 0 24 24",
					"svg_markup": "\n                  <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                  <polyline points=\"12 6 12 12 16 14\"/>\n                ",
					"title": "Paced for depth",
					"sub": "Signature Journey structure",
					"aria_hidden_2": "true",
					"viewbox_2": "0 0 24 24",
					"icon_points": "6 9 12 15 18 9",
					"role_2": "region",
					"content_markup": "\n              The Signature Journey runs 10 days across three movements, Heritage, Safari, and the Cape, with optional extensions to Victoria Falls and Chobe. This pacing is what gives the journey its depth.\n            ",
					"_uew_sep": "\n\n        <!-- ── Item 5: Flexible Journey Lengths ───────── -->\n        "
				},
				{
					"role": "listitem",
					"aria_hidden": "true",
					"viewbox": "0 0 24 24",
					"svg_markup": "\n                  <path d=\"M18 8h1a4 4 0 0 1 0 8h-1\"/>\n                  <path d=\"M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z\"/>\n                  <line x1=\"6\"  y1=\"1\" x2=\"6\"  y2=\"4\"/>\n                  <line x1=\"10\" y1=\"1\" x2=\"10\" y2=\"4\"/>\n                  <line x1=\"14\" y1=\"1\" x2=\"14\" y2=\"4\"/>\n                ",
					"title": "Flavours that meet your needs",
					"sub": "Regional cuisine &amp; dietary care",
					"aria_hidden_2": "true",
					"viewbox_2": "0 0 24 24",
					"icon_points": "6 9 12 15 18 9",
					"role_2": "region",
					"content_markup": "\n              You taste regional cuisine prepared by local hosts and chefs throughout. Dietary needs are collected in advance and handled with care, because your wellbeing is part of the journey.\n            ",
					"_uew_sep": "\n\n        <!-- ── Item 6: Cuisine & Dietary Care ─────────── -->\n        "
				}
