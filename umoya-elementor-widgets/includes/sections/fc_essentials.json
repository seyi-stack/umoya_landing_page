				},
				{
					"role": "listitem",
					"aria_hidden": "true",
					"viewbox": "0 0 24 24",
					"svg_markup": "\n                  <path d=\"M12 20h9\"/>\n                  <path d=\"M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z\"/>\n                ",
					"title": "Your journey, your way",
					"sub": "Thoughtful personalization",
					"aria_hidden_2": "true",
					"viewbox_2": "0 0 24 24",
					"icon_points": "6 9 12 15 18 9",
					"role_2": "region",
					"content_markup": "\n              Each itinerary is carefully designed, and yours can flex to your interests. Optional experiences let you add private tastings, extended time at a site, or access to a particular host.\n            ",
					"_uew_sep": "\n\n        <!-- ── Item 3: Personalization ────────────────── -->\n        "
				},
				{
					"role": "listitem",
					"aria_hidden": "true",
					"viewbox": "0 0 24 24",
					"svg_markup": "\n                  <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                ",
					"title": "Peace of mind for your investment",
					"sub": "Travel protection",
					"aria_hidden_2": "true",
					"viewbox_2": "0 0 24 24",
					"icon_points": "6 9 12 15 18 9",
					"role_2": "region",
					"content_markup": "\n              We <strong>strongly recommend travel insurance</strong> at the time of booking. Your travel expert can guide you to reputable providers so you can focus on the journey, not the logistics.\n            ",
					"_uew_sep": "\n\n        <!-- ── Item 4: Travel Protection ─────────────── -->\n        "
				},
				{
					"role": "listitem",
					"aria_hidden": "true",
					"viewbox": "0 0 24 24",
					"svg_markup": "\n                  <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                  <polyline points=\"12 6 12 12 16 14\"/>\n                ",
					"title": "Paced for depth",
					"sub": "Signature Journey structure",
					"aria_hidden_2": "true",
					"viewbox_2": "0 0 24 24",
					"icon_points": "6 9 12 15 18 9",
					"role_2": "region",
					"content_markup": "\n              The Signature Journey runs 10 days across three movements, Heritage, Safari, and the Cape, with optional extensions to Victoria Falls and Chobe. This pacing is what gives the journey its depth.\n            ",
