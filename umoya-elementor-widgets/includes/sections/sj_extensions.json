			"id": "content_p_sj_ext_tile_div_nth_of_type_2_p_nth_of_type_1",
			"label": "Card Text 3",
			"sample": "The journey carries north to Victoria Falls, on…",
			"region_label": "Card",
			"controls": [
				{
					"id": "text_text_3",
					"control": "textarea",
					"label": "Text 1",
					"description": "",
					"default": "The journey carries north to Victoria Falls, one of the seven natural wonders of the world, on the border of Zimbabwe and Zambia. Feel the mist, hear the thunder, and stand close enough to the falls to understand why they are called the smoke that thunders. You stay three nights on the banks of the Zambezi at Victoria Falls River Lodge, with a sunset cruise on the river, a guided tour of the falls, and a Boma dinner under the stars.",
					"esc": "post",
					"group": "p_sj_ext_tile_div_nth_of_type_2_p_nth_of_type_1",
					"sort": 0,
					"part_label": "Card Text 3"
				},
				{
					"id": "text_text_6",
					"control": "textarea",
					"label": "Text 2",
					"description": "",
					"default": "Everything in Extension One, then you cross into Botswana and finish on the water, aboard a private houseboat on the Chobe River. Drift at golden hour as elephants gather on the banks in numbers found almost nowhere else on earth, and close the journey on the river itself.",
					"esc": "post",
					"group": "p_sj_ext_tile_div_nth_of_type_2_p_nth_of_type_1",
					"sort": 0,
					"part_label": "Card Text 3"
				}
			]
		}
