					"decoding": "async",
					"title": "Solo Travel",
					"desc": "Arrive alone, leave with connections that last. Umoya's small groups bring together like-minded travelers, so the people you meet along the way become as much a part of the journey as the places you see."
				},
				{
					"role": "listitem",
					"notes": "\n          <!-- ★ SWAP: Couples Getaway image -->\n          ",
					"src": "https://umoyaafrikatours.co.za/wp-content/uploads/2026/optimized/umoya_compressed_ZAV_8926.png",
