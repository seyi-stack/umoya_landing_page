				{
					"id": "tile_img_markup",
					"control": "textarea",
					"label": "Tile Img markup (HTML)",
					"esc": "raw",
					"default": "\n            <!-- Soweto image — ZAV_6406, the one approved Eyethu shot -->\n            <img class=\"fc-jrn-pic\" src=\"https://umoyaafrikatours.co.za/wp-content/uploads/2026/optimized/umoya_compressed_ZAV_6406.png\" alt=\"Eyethu Heritage Hall — Johannesburg &amp; Soweto history and culture\" loading=\"lazy\" />\n            <div class=\"fc-jrn-tag\">\n              <h3 class=\"fc-jrn-tile-ttl\">History &amp; Culture</h3>\n            </div>\n          "
				},
				{
					"id": "loc",
					"control": "text",
					"label": "Loc",
					"esc": "post",
					"default": "Johannesburg &amp; Soweto"
				},
				{
					"id": "desc_markup",
					"control": "textarea",
					"label": "Desc markup (HTML)",
					"esc": "raw",
					"default": "A warm welcome from <span class=\"fc-jrn-nm\">Lucia Motloung</span>, a CEO of black-owned wine company Luc Mo Wines, ride through the colorful streets of Soweto, where history and culture come to light before your eyes. Have lunch with <span class=\"fc-jrn-nm\">Antoinette Sithole</span>, sister of the late Hector Pieterson whose legacy in the anti-apartheid movement lives on."
				},
				{
					"id": "_uew_sep",
					"control": "hidden",
					"label": "Separator markup",
					"esc": "raw",
					"default": "\n\n        <!-- Chapter II -->\n        "
				}
			],
			"rows": [
				{
					"tile_img_markup": "\n            <!-- Soweto image — ZAV_6406, the one approved Eyethu shot -->\n            <img class=\"fc-jrn-pic\" src=\"https://umoyaafrikatours.co.za/wp-content/uploads/2026/optimized/umoya_compressed_ZAV_6406.png\" alt=\"Eyethu Heritage Hall — Johannesburg &amp; Soweto history and culture\" loading=\"lazy\" />\n            <div class=\"fc-jrn-tag\">\n              <h3 class=\"fc-jrn-tile-ttl\">History &amp; Culture</h3>\n            </div>\n          ",
					"loc": "Johannesburg &amp; Soweto",
					"desc_markup": "A warm welcome from <span class=\"fc-jrn-nm\">Lucia Motloung</span>, a CEO of black-owned wine company Luc Mo Wines, ride through the colorful streets of Soweto, where history and culture come to light before your eyes. Have lunch with <span class=\"fc-jrn-nm\">Antoinette Sithole</span>, sister of the late Hector Pieterson whose legacy in the anti-apartheid movement lives on.",
					"_uew_sep": ""
				},
				{
					"tile_img_markup": "\n            <img class=\"fc-jrn-pic\" src=\"https://umoyaafrikatours.co.za/wp-content/uploads/2026/optimized/umoya_compressed_img001238.jpeg\" alt=\"Safari game drives in the Sabi Sand\" loading=\"lazy\" />\n            <div class=\"fc-jrn-tag\">\n              <h3 class=\"fc-jrn-tile-ttl\">Safari Game Drives</h3>\n            </div>\n          ",
					"loc": "The Sabi Sand",
					"desc_markup": "There are few places on earth where you can watch lions, leopards, elephants, buffalo, and rhinos move freely through the wild. Days in the Sabi Sand follow the rhythm of the bush: early morning game drives as the light breaks, and golden-hour sundowners as the day slows down.",
					"_uew_sep": "\n\n        <!-- Chapter II -->\n        "
				},
				{
					"tile_img_markup": "\n            <img class=\"fc-jrn-pic\" src=\"https://umoyaafrikatours.co.za/wp-content/uploads/2026/optimized/umoya_compressed_img1777576366.jpeg\" alt=\"Cape Town — where mountain meets ocean\" loading=\"lazy\" />\n            <div class=\"fc-jrn-tag\">\n              <h3 class=\"fc-jrn-tile-ttl\">The Cape</h3>\n            </div>\n          ",
					"loc": "Cape Town",
					"desc_markup": "Experience the city where mountain meets ocean: Robben Island with <span class=\"fc-jrn-nm\">Christo Brand</span>, the warder who once guarded Mandela, and a day on the Black-owned Winelands route with <span class=\"fc-jrn-nm\">Ntsiki Biyela</span>, the first Black woman winemaker in South Africa.",
					"_uew_sep": "\n\n        <!-- Chapter III -->\n        "
				}
			],
			"selector": ".fc-jrn-tile"
		},
